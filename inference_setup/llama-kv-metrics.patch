diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index a5cba1d..24476db 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -3111,6 +3111,19 @@ private:
                     res->n_tasks_deferred    = queue_tasks.queue_tasks_deferred_size();
                     res->metrics             = metrics;
 
+                    // KV cache occupancy: sum of positions held by each slot's sequence
+                    {
+                        llama_memory_t mem = llama_get_memory(ctx_tgt);
+                        for (const server_slot & slot : slots) {
+                            const llama_pos pos_min = llama_memory_seq_pos_min(mem, slot.id);
+                            const llama_pos pos_max = llama_memory_seq_pos_max(mem, slot.id);
+                            if (pos_max >= 0) {
+                                res->n_kv_tokens_used += pos_max - pos_min + 1;
+                            }
+                        }
+                        res->n_kv_tokens_total = n_ctx;
+                    }
+
                     if (task.metrics_reset_bucket) {
                         metrics.reset_bucket();
                     }
